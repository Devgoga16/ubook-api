NODE_ENV=development
PORT=3000

# MongoDB debe ser un replica set (las transacciones lo requieren).
# MongoDB Atlas (incluido el tier gratis) ya lo es.
MONGODB_URI=mongodb://localhost:27017/ubook?replicaSet=rs0

# Mínimo 32 caracteres. Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30

# Orígenes del frontend, separados por coma.
CORS_ORIGIN=http://localhost:5173
# lax: web y API en el mismo sitio (app.tudominio.com + api.tudominio.com).
# none: dominios distintos (p. ej. *.vercel.app + *.onrender.com); exige HTTPS.
COOKIE_SAMESITE=lax

TRIAL_DAYS=30
TRIAL_PLAN_CODE=pro

# Primer super admin (solo se crea si no existe ninguno).
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# Clave para cifrar fichas clínicas (32 bytes en base64). Obligatoria en producción.
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ¡Respáldala! Sin ella las fichas no se pueden leer.
RECORDS_ENCRYPTION_KEY=

# Correos (Resend: https://resend.com). Sin API key, los correos se muestran en la consola de la API.
# RESEND_API_KEY=re_xxx
# MAIL_FROM=uBook <notificaciones@tudominio.pe>
# URL de la app web para los enlaces de los correos (por defecto, el primer CORS_ORIGIN).
# APP_URL=http://localhost:5173

# Cobro de la suscripción de uBook a los negocios (se muestra en Configuración → Plan y pagos).
# BILLING_YAPE=987 654 321 · Unify Tec S.A.C.
# BILLING_BANK=BCP Soles 191-1234567-0-12 · CCI 002-191-001234567012-55 · Unify Tec S.A.C.
# BILLING_CONTACT=WhatsApp 987 654 321 · pagos@unifytec.pe

# WhatsApp (API de Unify). Sin API key, los mensajes se muestran en la consola de la API.
# WHATSAPP_API_URL=https://api-ws-unify.rapi-almacen.shop/api
# WHATSAPP_SESSION=tu-sesion
# WHATSAPP_API_KEY=tu-api-key

# Cloudflare R2 (bucket PRIVADO) para fotos de comprobantes. Sin esto, se guardan en LOCAL_UPLOADS_DIR.
# R2_ACCOUNT_ID=tu-account-id
# R2_ACCESS_KEY_ID=...
# R2_SECRET_ACCESS_KEY=...
# R2_BUCKET=ubook-comprobantes
# LOCAL_UPLOADS_DIR=.uploads
